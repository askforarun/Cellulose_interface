# Final stage coordinates: keep original construction inputs tracked
cellulose_ethanol/em.gro
cellulose_ethanol/npt.gro
cellulose_ethanol/nvt_production.gro
cellulose_ethanol/inputs.ready

# OS/editor files
.DS_Store
*.swp

# Pure-liquid generated coordinates (retain the single-molecule template)
cellulose_ethanol/pure_ethanol/*.gro
!cellulose_ethanol/pure_ethanol/ethanol.gro

# Continuation-stage generated outputs and completion markers
cellulose_ethanol/npt_extended*.gro
cellulose_ethanol/nvt_production_extended.gro
*.done
.*_offsets.npz
.*_offsets.lock

# Larger-reservoir runtime coordinates
cellulose_ethanol/em_3000.gro
cellulose_ethanol/npt_3000.gro

# Analysis, plotting, and report outputs (not part of the setup example)
plot_density_profile.py
cellulose_ethanol/analyze_density*.sbatch
cellulose_ethanol/analyze_extended_density.sbatch
cellulose_ethanol/density_*
cellulose_ethanol/extended_density_*
cellulose_ethanol/normalized_density_*
cellulose_ethanol/*_density_windows.*
cellulose_ethanol/interface.pdf
cellulose_ethanol/interface_report.*
cellulose_ethanol/pure_ethanol/*.xvg
cellulose_ethanol/pure_ethanol/*.txt
cellulose_ethanol/pure_ethanol/*_report.json
