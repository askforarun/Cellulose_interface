; 2.5 ns restrained fixed-X/Y NPT for 3000 ethanol molecules (1500 per face).
nsteps                  = 1250000
continuation            = no
gen-vel                 = yes
gen-temp                = 298.15
gen-seed                = 20261016
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau-p                   = 5.0
ref-p                   = 1.0 1.0
; Fix the lateral cellulose lattice; relax only Z.
compressibility         = 0.0 4.5e-5
refcoord-scaling        = all
integrator              = md
dt                      = 0.002
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 298.15
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 2500
nstenergy               = 500
nstlog                  = 500
define                  = -DPOSRES_CELLULOSE
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
pbc                     = xyz
periodic-molecules      = yes
