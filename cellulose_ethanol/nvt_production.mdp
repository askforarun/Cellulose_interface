; 2 ns NVT production; edit nsteps to change duration.
; Keep the final NPT box, velocities, and cellulose restraint reference.
; POSRES_CELLULOSE restrains the selected layers only for a slab built with
; --restrain-layers; for a slab built with --no-restraints it has no effect.
nsteps                  = 1000000
continuation            = yes
gen-vel                 = no
pcoupl                  = no
integrator              = md
dt                      = 0.002
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0
ref-t                   = 298.15
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 2500
nstenergy               = 500
nstlog                  = 500
define                  = -DPOSRES_CELLULOSE
cutoff-scheme           = Verlet
nstlist                 = 20
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
pbc                     = xyz
periodic-molecules      = yes
